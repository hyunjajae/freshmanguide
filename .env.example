# Supabase 프로젝트 정보
# ------------------------------------------------------------------
# 이 파일을 복사해서 이름을 ".env.local" 로 바꾼 뒤 값을 채워넣으세요.
#
# 값 찾는 곳: Supabase 대시보드 → Project Settings → API
#   VITE_SUPABASE_URL      = "Project URL"
#   VITE_SUPABASE_ANON_KEY = "Project API keys" 의 anon / public 키
# ------------------------------------------------------------------

VITE_SUPABASE_URL=https://여기에-프로젝트-주소.supabase.co
VITE_SUPABASE_ANON_KEY=여기에-anon-key-붙여넣기
